{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "dev (Debug, ASan + UBSan, warnings as errors)",
      "description": "Default preset for day-to-day work. Slow, loud, and honest.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EVENTBOOK_BUILD_TESTS": "ON",
        "EVENTBOOK_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "displayName": "release (optimized, no sanitizers)",
      "description": "Used for benchmarks and for any performance number that gets reported.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "EVENTBOOK_BUILD_TESTS": "ON",
        "EVENTBOOK_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "coverage (Debug + instrumentation)",
      "description": "Debug build instrumented for llvm-cov / gcov line coverage.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EVENTBOOK_BUILD_TESTS": "ON",
        "EVENTBOOK_WARNINGS_AS_ERRORS": "OFF",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping -g -O0",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate -fcoverage-mapping"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    { "name": "dev", "inherits": "test-base", "configurePreset": "dev" },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" },
    { "name": "coverage", "inherits": "test-base", "configurePreset": "coverage" }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    }
  ]
}
